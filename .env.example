# Aetheris Environment Configuration
# Copy this file to .env and fill in values

# === Google Cloud ===
GCP_PROJECT_ID=
GCP_REGION=us-central1

# === Gemini / Antigravity SDK ===
GEMINI_API_KEY=

# === BigQuery ===
BQ_DATASET=aetheris

# === Cesium / Maps ===
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=

# === External Data APIs ===
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
TOMTOM_API_KEY=
OPENAI_API_KEY=

# === Rate Limiting ===
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
